# Copy to secrets.toml and fill in. Top-level keys must stay ABOVE any [section].
#
# On Streamlit Cloud, paste these into Settings -> Secrets instead of committing them.

# Required — counselor login is disabled until this is set.
COUNSELOR_PASSWORD = "choose-a-strong-password"

# Optional — Postgres connection string (e.g. a free Supabase or Neon database).
# Leave unset for local development: the app then uses burnout.db (SQLite).
# Streamlit Cloud wipes local files on restart, so set this for any real deployment.
# DATABASE_URL = "postgresql://user:password@host:5432/dbname"
